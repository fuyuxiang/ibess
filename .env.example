# 智能评标现场视频监测 POC — 环境变量模板
# 执行 python3 scripts/init_env.py 生成随机基础设施口令，或复制为 .env 后自行填写。
# .env 仅保存在本机；不要把登录口令写进手册、源码或模板。

# ---------- 基础设施 ----------
POSTGRES_USER=demo
POSTGRES_PASSWORD=
POSTGRES_DB=demo
MINIO_ROOT_USER=demo
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=evidence

# ---------- 视频源（单路） ----------
# 现场 RTSP 地址及其凭据只填在本机 .env 中。
RTSP_URL=
CAMERA_NAME=会议室1

# ---------- 推理参数 ----------
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
VIDEO_FPS=5
INFERENCE_SIZE=640

# ---------- 音频 ----------
AUDIO_CHUNK_MS=500

# ---------- 取证 ----------
RING_SECONDS=30

# ---------- 管理员会话 ----------
# 本机HTTP演示使用false；HTTPS部署使用true。账号密码由首次打开页面自行设置。
AUTH_COOKIE_SECURE=false

# ---------- 语义研判（MiniMax云端API） ----------
# 不要提交真实Key；复制为.env后填写。
SEMANTIC_MODEL_BASE_URL=https://api.minimax.cn/v1
SEMANTIC_MODEL_NAME=MiniMax-M3.1-Flash-Preview
SEMANTIC_MODEL_API_KEY=
SEMANTIC_WORKER_ID=semantic-worker-1

# ---------- 阶段控制 ----------
PHASE_CONTROL_TOKEN_EVENT_SERVICE=

# ---------- 本机工具与部署目标（可选） ----------
# Node/npm 已在 PATH 中时留空；否则填本机 node 可执行文件所在目录。
POC_NODE_BIN=
POC_PYTHON=python3
POC_SCREENSHOT_DIR=
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_REMOTE_DIR=
# 获准使用的原始媒体应放仓库外，通过此项指定。
POC_VIDEO_DIR=
# 下列文件路径相对于 POC_VIDEO_DIR（容器内映射为 /videos）。
POC_VIDEO_PLAYLIST=playlist.txt
POC_DEMO_AUDIO_FILE=demo-audio.m4a

# 摄像头核心规则；连续画面复核使用支持图片输入的视觉模型。
A_EXT_ENABLED=1
CORE_BEHAVIORS_ENABLED=1
LATEST_FRAME_CAPTURE=1
CORE_REVIEW_INTERVAL=4
# 留空时复用现有 SEMANTIC_MODEL_* / VLM_MODEL 配置；无密钥时页面显示模型未配置。
VISUAL_MODEL_BASE_URL=
VISUAL_MODEL_NAME=
VISUAL_MODEL_API_KEY=
