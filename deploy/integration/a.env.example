# 负责人 A 的环境项（执行卡 10.2；5.01 更新）。需要的行追加到项目根 .env（.env.example 是同事的文件，不改）。
# 不要提交真实令牌。

# ---------- 5.01：vision-worker 里的 A 扩展开关（缺省全开，设 0 关闭）----------
# 注意：B 的 9 路视觉 worker（poc-vw-cam1～9）是预先建好的容器，环境变量在创建时固定；
# 要改这些开关，须在重建容器时用 recreate_vision_workers.sh --set KEY=VAL 带上（脚本照抄容器原有环境变量，不读 .env）。
# A_EXT_ENABLED=0 时整个扩展不加载，vision-worker 与改动前完全一样。
A_EXT_ENABLED=1
A_ZONES_ENABLED=1          # 5.1 区域事实：inside / zone_name 喂给 B 的 zone_intrusion
A_S03_SEAT_ENABLED=1       # 5.2 工位级离岗（画面仍有人、某工位空置）；许可读 6.1 leave_permit
A_S05_ENABLED=1            # 7.3 S05 两人接近停留
A_S09_MOTION_ENABLED=1     # 7.4 S09 画面快速动作（单模态，证据不足）
A_HEALTH_ENABLED=1         # 5.3 过暗过曝、失焦、镜头偏移（断流与黑屏归 B）
A_HEALTH_INTERVAL_SECONDS=1   # 画面质量检查间隔；画面先缩到 320 宽再算，不占 B 的帧预算
# 镜头偏移只有配了参考图才检测（容器内路径，摄像头正常位置的截图）；不配就不做偏移检测，免得人走动、视频循环误报
A_SHIFT_REFERENCE=
A_SHIFT_ROI=0,0,1,1           # 参考图里用于比对的区域（归一化 x1,y1,x2,y2），选画面里固定不动的部分
A_VISUAL_REVIEW_ENABLED=1  # 7.1 视觉模型复核；还要配下面的 VISUAL_MODEL_BASE_URL 才会真的调用
A_S08_CARRY_ENABLED=1      # 7.3 S08 资料携离（依赖 7.1：纸张候选要经视觉模型复核）
A_CONTEXT_REFRESH_SECONDS=30   # 从库里刷新区域配置 / 阶段快照 / 许可的间隔（后台线程读，连接与查询各限 2 秒，库慢不拖住检测）
A_LEAVE_PERMIT_MINUTES=30      # 6.1 离岗许可没有结束时间时，按登记时刻起多少分钟有效
A_EXT_MIN_INTERVAL_SECONDS=0   # 扩展最小运行间隔；GPU / CPU 吃紧时调大（如 0.5）

# ---------- 7.1 视觉模型（不配就跳过复核，不影响其他）----------
VISUAL_MODEL_BASE_URL=
VISUAL_MODEL_NAME=
VISUAL_MODEL_API_KEY=
VISUAL_MODEL_TIMEOUT=60

# ---------- 素材根（4.1 / 4.2 / 9.4 共用，只读挂载到容器 /stage-assets）----------
# 宿主机上的授权素材目录；缺省为项目根 stage_assets/
POC_STAGE_ASSETS_DIR=

# ---------- 阶段媒体控制器（4.2，-Media 时需要）----------
# 按真实场次与源填写，没有默认值；控制器不会猜「最近场次」
MEDIA_SESSION_ID=
MEDIA_SOURCE_ID=
MEDIA_CONSUMER_ID=media-controller
# 2.2 控制接口令牌；不填则照常推流但不回 ACK（阶段同步状态停在 pending）
MEDIA_CONTROL_TOKEN=
# 5.01：缺省推独立的 stage 路径，不与 B 的 poc-pub-cam1～9（cam1～cam9）互相顶掉
RTSP_PUBLISH_URL=rtsp://mediamtx:8554/stage
MEDIA_CONFIRM_SECONDS=5
MEDIA_STOP_GRACE_SECONDS=3
# 1 = 每轮推流前复核素材 SHA256（大文件会慢）
MEDIA_VERIFY_SHA256=0

# ---------- 视觉离线质检 worker（9.4，-Offline 时需要 GPU 与权重）----------
# 容器内路径；../dev_assets 只读挂载在 /assets（与 vision-worker 相同）
OFFLINE_DETECTOR_WEIGHTS=/assets/yolov8n.pt
# 宿主机上同一权重的路径，start_a.ps1 用它判断「未就绪」
OFFLINE_DETECTOR_HOST_WEIGHTS=
OFFLINE_DETECTOR_DEVICE=cuda
OFFLINE_WORKER_ID=offline-worker-1
OFFLINE_LEASE_SECONDS=120
