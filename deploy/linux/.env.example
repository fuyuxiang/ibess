# 智能评标现场视频监测 —— Linux 服务器环境变量
# 用法：cp deploy/linux/.env.example .env  然后按实际修改（尤其是密码和模型密钥）
# .env 不要提交到仓库

# ---------- 基础设施 ----------
POSTGRES_USER=demo
POSTGRES_PASSWORD=
POSTGRES_DB=demo

MINIO_ROOT_USER=demo
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=evidence

# ---------- 端口（宿主机侧；服务器上这些端口可能被别的系统占用，按实际情况改）----------
# 要只允许本机访问，写成 127.0.0.1:15432 这种形式
POC_WEB_PORT=3080
POC_API_PORT=8000
POC_PG_PORT=127.0.0.1:15432
POC_REDIS_PORT=127.0.0.1:16379
POC_MINIO_PORT=127.0.0.1:19000
POC_MINIO_CONSOLE_PORT=127.0.0.1:19001
POC_RTSP_PORT=8554
POC_HLS_PORT=8888

# ---------- 视频源 ----------
# 现场真实摄像头 RTSP 地址；没有就留空，先用演示摄像头
RTSP_URL=
CAMERA_NAME=演示评标室
# 会话 Cookie 是否只走 HTTPS；内网 http 访问填 false
AUTH_COOKIE_SECURE=false

# ---------- 推理参数（一般不用改）----------
YOLO_MODEL=/assets/yolov8n.pt
YOLO_CONF=0.35
VIDEO_FPS=10
INFERENCE_SIZE=640

# ---------- 语音 ----------
AUDIO_CHUNK_MS=500
RING_SECONDS=30
# 现场拾音用的音频文件或流（留空则用默认素材）
AUDIO_SOURCE=
AUDIO_ID=

# ---------- 大模型（语义研判）----------
# 不填则语义复核走规则兜底，不影响其他功能
SEMANTIC_MODEL_BASE_URL=https://api.minimax.cn/v1
SEMANTIC_MODEL_NAME=MiniMax-M3.1-Flash
SEMANTIC_MODEL_API_KEY=
SEMANTIC_WORKER_ID=semantic-worker-1

# ---------- 事件服务 ----------
PHASE_CONTROL_TOKEN_EVENT_SERVICE=
