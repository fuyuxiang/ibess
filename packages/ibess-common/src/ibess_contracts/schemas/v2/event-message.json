{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event-message",
  "type": "object",
  "required": [
    "contract_version",
    "event_id",
    "event_type",
    "camera_id",
    "session_id",
    "risk_level",
    "reason",
    "status",
    "occurred_at"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "none",
        "info",
        "low",
        "medium",
        "high"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
