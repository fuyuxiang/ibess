{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibess.local/contracts/v2/evidence-ref.schema.json",
  "title": "evidence-ref",
  "type": "object",
  "required": [
    "contract_version",
    "project_id",
    "room_id",
    "session_id",
    "asset_id",
    "source_id",
    "media_run_id",
    "evidence_id",
    "evidence_type",
    "start_ms",
    "end_ms",
    "sha256",
    "status"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "room_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "media_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_type": {
      "enum": [
        "video",
        "audio",
        "keyframe",
        "transcript",
        "gap",
        "scoring"
      ]
    },
    "start_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "end_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "missing",
        "partial",
        "failed"
      ]
    }
  },
  "additionalProperties": true
}
